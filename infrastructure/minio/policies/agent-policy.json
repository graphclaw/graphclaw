{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AgentPrincipalObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:ListBucket",
        "s3:GetBucketLocation",
        "s3:ListMultipartUploadParts",
        "s3:AbortMultipartUpload"
      ],
      "Resource": [
        "arn:aws:s3:::graphclaw",
        "arn:aws:s3:::graphclaw/*"
      ]
    },
    {
      "Sid": "AgentPrincipalDenyDeleteObject",
      "Effect": "Deny",
      "Action": [
        "s3:DeleteObject",
        "s3:DeleteObjects"
      ],
      "Resource": [
        "arn:aws:s3:::graphclaw/*"
      ]
    },
    {
      "Sid": "AgentPrincipalDenyBucketLifecycle",
      "Effect": "Deny",
      "Action": [
        "s3:PutLifecycleConfiguration",
        "s3:DeleteBucketLifecycle"
      ],
      "Resource": [
        "arn:aws:s3:::graphclaw"
      ]
    }
  ]
}
