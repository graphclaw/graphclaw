{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "S3UserTaskFiles",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::graphclaw-tasks",
        "arn:aws:s3:::graphclaw-tasks/users/*"
      ],
      "Condition": {
        "StringLike": {
          "s3:prefix": ["users/${aws:PrincipalTag/UserId}/*"]
        }
      }
    },
    {
      "Sid": "SQSInboundConsume",
      "Effect": "Allow",
      "Action": [
        "sqs:ReceiveMessage",
        "sqs:DeleteMessage",
        "sqs:GetQueueAttributes"
      ],
      "Resource": "arn:aws:sqs:*:*:graphclaw-inbound-messages"
    },
    {
      "Sid": "SecretsManagerLLMKeys",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:graphclaw/llm/*"
    },
    {
      "Sid": "SecretsManagerBYOK",
      "Effect": "Allow",
      "Action": [
        "secretsmanager:GetSecretValue"
      ],
      "Resource": "arn:aws:secretsmanager:*:*:secret:graphclaw/byok/user-*"
    },
    {
      "Sid": "DenyDangerousActions",
      "Effect": "Deny",
      "Action": [
        "iam:*",
        "sts:AssumeRole",
        "s3:DeleteBucket"
      ],
      "Resource": "*"
    }
  ]
}
