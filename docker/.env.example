# GraphClaw — environment variable template
#
# Copy this file to .env (in the same directory) and fill in real values before
# running `docker compose up`. `.env` is gitignored; this template is checked in.
#
# Generate strong secrets with: openssl rand -base64 32
# See docs/how-to/self-host.md for full setup instructions and IdP registration
# walkthroughs (Google, GitHub, Microsoft OAuth).

# Postgres password for the local dev database (REQUIRED)
# Generate with: openssl rand -base64 32
DB_PASSWORD=change-me-use-openssl-rand-base64-32

# Anthropic API key — required for the orchestrator agent
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key — optional alternative provider for the orchestrator agent
OPENAI_API_KEY=

# Default provider when BOTH Anthropic and OpenAI keys are configured.
# Allowed values: anthropic | openai | litellm
GRAPHCLAW_DEFAULT_LLM_PROVIDER=anthropic

# ── Ollama Local LLM Configuration ────────────────────────────────────────
# Ollama base URL for local model inference (cost-free development)
# Use http://host.docker.internal:11434 for Docker on Mac/Windows
# Use http://localhost:11434 for local development
OLLAMA_API_BASE=http://localhost:11434

# Default Ollama model to use (pull with: ollama pull <model>)
# Recommended: llama3.2, qwen2.5-coder, deepseek-r1
OLLAMA_DEFAULT_MODEL=llama3.2

# LiteLLM default model (supports provider prefixes: anthropic/, openai/, ollama_chat/)
# Examples:
#   anthropic/claude-sonnet-4-20250514 (uses Anthropic API)
#   openai/gpt-4o (uses OpenAI API)
#   ollama_chat/llama3.2 (uses local Ollama's native /api/chat — supports real
#     multi-turn history and tool-calling; NOT "ollama/", which routes through
#     Ollama's legacy /api/generate text-completion endpoint and flattens the
#     whole conversation into one prompt with no native tool support — this
#     caused small models to echo raw tool-result JSON as their final reply)
# Set this to ollama_chat/llama3.2 for cost-free local development
LITELLM_DEFAULT_MODEL=claude-sonnet-4-20250514

# Secrets backend (keep as env_file for local dev)
SECRETS_BACKEND=env_file

# Redis connection URL (local dev)
REDIS_URL=redis://localhost:6379

# MinIO object storage (local dev S3-compatible) (REQUIRED)
# Generate with: openssl rand -base64 32
MINIO_PASSWORD=change-me-use-openssl-rand-base64-32
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=graphclaw

# ── Wave 0: No-Delete principal credentials ────────────────────────────────
# Feature flag — flip to "true" ONLY after all Wave 0 PRs merged + probes green.
GRAPHCLAW_NO_DELETE_ENFORCEMENT=false

# agent_principal: least-privilege DB role (no DELETE grants)
AGENT_PRINCIPAL_SECRET=agent_secret_change_me

# admin_principal: full DB grants (purge worker + admin API only)
ADMIN_PRINCIPAL_SECRET=admin_secret_change_me

# migration_principal: DDL grants only (migration runner)
MIGRATION_PRINCIPAL_SECRET=migration_secret_change_me

# ── Phase 2: Gateway channels ─────────────────────────────────────────────

# Enabled gateway channels (comma-separated, default: email)
# Add "whatsapp" and/or "telegram" to enable those channels.
GATEWAY_ENABLED_CHANNELS=email

# WhatsApp Business Cloud API
# Get from: Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Telegram Bot API
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_POLL_TIMEOUT=30

# ── Phase 5: Slack + Teams ────────────────────────────────────────────────

# Slack Bot API
# Get SLACK_BOT_TOKEN from: Slack App settings → OAuth & Permissions → Bot User OAuth Token
# Get SLACK_SIGNING_SECRET from: Slack App settings → Basic Information → Signing Secret
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Microsoft Teams Bot Framework
# Register a bot at: Azure Portal → Azure Active Directory → App registrations
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_WEBHOOK_URL=

# ── Phase 5: SES Inbound Email ────────────────────────────────────────────
# Set EMAIL_BACKEND=ses in production; keep imap for local dev.
# SES_LAMBDA_SECRET must match GATEWAY_SECRET in the Lambda environment.
SES_S3_BUCKET=graphclaw-inbound-email
SES_LAMBDA_SECRET=
EMAIL_BACKEND=imap

# ── Auth (OAuth 2.0 + JWT) ─────────────────────────────────────────────────
# RS256 key pair — generate with: openssl genrsa 2048 | tee jwt_private.pem
# For local dev, leave blank and a temporary key pair is generated in memory.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Runtime environment — controls dev-only features (dev-token endpoint).
# MUST be set to "production" in all cloud deployments.
# Defaults to "production" when unset (safe default).
ENVIRONMENT=development

# OAuth IdP credentials (register apps at each IdP's developer console)
# OAUTH_REDIRECT_BASE_URL: base URL of this API server (where IdP sends the callback)
# COCKPIT_BASE_URL: base URL of the cockpit SPA (where browser lands after auth)
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
COCKPIT_BASE_URL=http://localhost:3000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ── Phase 5: Sub-Agent Parallel Orchestration ────────────────────────────────
# Maximum number of SubAgentRunner instances active simultaneously.
# Jobs beyond this cap queue in AGENT_JOBS broker queue.
GRAPHCLAW_MAX_CONCURRENT_AGENTS=4

# Dedicated SkillWorker pool size for sub-agents (separate from orchestrator pool).
GRAPHCLAW_SUBAGENT_WORKER_POOL_SIZE=4

# How often (seconds) each SubAgentRunner emits a heartbeat event.
GRAPHCLAW_AGENT_HEARTBEAT_INTERVAL_SECONDS=60

# Inactivity threshold (seconds) before AgentHealthMonitor marks task BLOCKED.
GRAPHCLAW_AGENT_HEARTBEAT_TIMEOUT_SECONDS=300

# ── Wave Model-Routing: per-role LLM model selection ───────────────────────
# Each role independently resolves: GRAPHCLAW_MODEL_<ROLE> -> legacy env
# (distill/summarize/classify only) -> GRAPHCLAW_MODEL_DEFAULT ->
# LITELLM_DEFAULT_MODEL. With none of these set, every role falls back to
# LITELLM_DEFAULT_MODEL — fully backward compatible with a single-model setup.
# An inline "<provider>:<model>" prefix (e.g. "litellm:ollama_chat/qwen2.5:14b")
# selects a provider without a separate _PROVIDER_ var.
#
# GRAPHCLAW_MODEL_DEFAULT=
# GRAPHCLAW_MODEL_ORCHESTRATOR=
# GRAPHCLAW_MODEL_SUBAGENT=
# GRAPHCLAW_MODEL_SKILL=
# GRAPHCLAW_MODEL_DISTILL=
# GRAPHCLAW_MODEL_CLASSIFY=
# GRAPHCLAW_MODEL_SUMMARIZE=
#
# Provider override per role (rarely needed — usually inferred from the
# model string's prefix or the provider selected at startup):
# GRAPHCLAW_MODEL_PROVIDER_DEFAULT=
# GRAPHCLAW_MODEL_PROVIDER_ORCHESTRATOR=
# GRAPHCLAW_MODEL_PROVIDER_SUBAGENT=
# GRAPHCLAW_MODEL_PROVIDER_SKILL=
# GRAPHCLAW_MODEL_PROVIDER_DISTILL=
# GRAPHCLAW_MODEL_PROVIDER_CLASSIFY=
# GRAPHCLAW_MODEL_PROVIDER_SUMMARIZE=

# ── Wave Model-Routing: prompt/context budget ──────────────────────────────
# Defaults assume a large hosted context window (200k tokens). Local models
# have much smaller windows — e.g. qwen2.5:7b/14b via Ollama have 32768 —
# and GRAPHCLAW_CONTEXT_MODEL_WINDOW_TOKENS must be set accordingly, or no
# budget check below ever trips.
# GRAPHCLAW_CONTEXT_MODEL_WINDOW_TOKENS=200000
# GRAPHCLAW_CONTEXT_RESERVE_OUTPUT_TOKENS=4096
# GRAPHCLAW_CONTEXT_PROMPT_BUDGET_PCT=70
# GRAPHCLAW_CONTEXT_SYSTEM_BUDGET_PCT=30
# GRAPHCLAW_CONTEXT_TOOLS_BUDGET_PCT=20
# GRAPHCLAW_CONTEXT_HISTORY_BUDGET_PCT=50
#
# Per-section caps (system prompt):
# GRAPHCLAW_CONTEXT_PERSONA_MAX_CHARS=2000
# GRAPHCLAW_CONTEXT_SEMANTIC_INDEX_MAX_TOPICS=15
# GRAPHCLAW_CONTEXT_AGENT_CATALOG_MAX_AGENTS=10
# GRAPHCLAW_CONTEXT_GRAPH_SUMMARY_MAX_CHARS=2000
# GRAPHCLAW_CONTEXT_KB_INDEX_MAX_CHARS=1500
# GRAPHCLAW_CONTEXT_SKILLS_SUMMARY_MAX_ITEMS=8
# GRAPHCLAW_CONTEXT_MCP_SUMMARY_MAX_ITEMS=5
#
# Tool sets — max non-core sets active at once before eviction:
# GRAPHCLAW_CONTEXT_MAX_ACTIVE_TOOL_SETS=2
#
# Tool-result truncation / cross-iteration pruning (agentic loop):
# GRAPHCLAW_CONTEXT_TOOL_RESULT_MAX_CHARS=2000
# GRAPHCLAW_CONTEXT_TOOL_RESULT_KEEP_RECENT=3
# GRAPHCLAW_CONTEXT_TOOL_RESULT_DIGEST_CHARS=300
#
# History actually sent to the LLM (distinct from GRAPHCLAW_MEMORY_HISTORY_MAX,
# which governs what is persisted):
# GRAPHCLAW_CONTEXT_HISTORY_TURNS_SENT=12
#
# Sub-agent context isolation:
# GRAPHCLAW_CONTEXT_SUBAGENT_EPISODIC_MAX_ENTRIES=3
# GRAPHCLAW_CONTEXT_SUBAGENT_EPISODIC_MAX_CHARS=4000
# GRAPHCLAW_CONTEXT_SUBAGENT_PROMPT_MAX_CHARS=24000
