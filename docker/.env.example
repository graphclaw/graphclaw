# GraphClaw — environment variable template
#
# Copy this file to .env (in the same directory) and fill in real values before
# running `docker compose up`. `.env` is gitignored; this template is checked in.
#
# Generate strong secrets with: openssl rand -base64 32
# See docs/how-to/self-host.md for full setup instructions and IdP registration
# walkthroughs (Google, GitHub, Microsoft OAuth).

# Postgres password for the local dev database (REQUIRED)
# Generate with: openssl rand -base64 32
DB_PASSWORD=change-me-use-openssl-rand-base64-32

# Anthropic API key — required for the orchestrator agent
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key — optional alternative provider for the orchestrator agent
OPENAI_API_KEY=

# Default provider when BOTH Anthropic and OpenAI keys are configured.
# Allowed values: anthropic | openai
GRAPHCLAW_DEFAULT_LLM_PROVIDER=anthropic

# Secrets backend (keep as env_file for local dev)
SECRETS_BACKEND=env_file

# Redis connection URL (local dev)
REDIS_URL=redis://localhost:6379

# MinIO object storage (local dev S3-compatible) (REQUIRED)
# Generate with: openssl rand -base64 32
MINIO_PASSWORD=change-me-use-openssl-rand-base64-32
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=graphclaw

# ── Wave 0: No-Delete principal credentials ────────────────────────────────
# Feature flag — flip to "true" ONLY after all Wave 0 PRs merged + probes green.
GRAPHCLAW_NO_DELETE_ENFORCEMENT=false

# agent_principal: least-privilege DB role (no DELETE grants)
AGENT_PRINCIPAL_SECRET=agent_secret_change_me

# admin_principal: full DB grants (purge worker + admin API only)
ADMIN_PRINCIPAL_SECRET=admin_secret_change_me

# migration_principal: DDL grants only (migration runner)
MIGRATION_PRINCIPAL_SECRET=migration_secret_change_me

# ── Phase 2: Gateway channels ─────────────────────────────────────────────

# Enabled gateway channels (comma-separated, default: email)
# Add "whatsapp" and/or "telegram" to enable those channels.
GATEWAY_ENABLED_CHANNELS=email

# WhatsApp Business Cloud API
# Get from: Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v20.0

# Telegram Bot API
# Get TELEGRAM_BOT_TOKEN from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_USE_WEBHOOK=false
TELEGRAM_POLL_TIMEOUT=30

# ── Phase 5: Slack + Teams ────────────────────────────────────────────────

# Slack Bot API
# Get SLACK_BOT_TOKEN from: Slack App settings → OAuth & Permissions → Bot User OAuth Token
# Get SLACK_SIGNING_SECRET from: Slack App settings → Basic Information → Signing Secret
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=

# Microsoft Teams Bot Framework
# Register a bot at: Azure Portal → Azure Active Directory → App registrations
TEAMS_TENANT_ID=
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
TEAMS_WEBHOOK_URL=

# ── Phase 5: SES Inbound Email ────────────────────────────────────────────
# Set EMAIL_BACKEND=ses in production; keep imap for local dev.
# SES_LAMBDA_SECRET must match GATEWAY_SECRET in the Lambda environment.
SES_S3_BUCKET=graphclaw-inbound-email
SES_LAMBDA_SECRET=
EMAIL_BACKEND=imap

# ── Auth (OAuth 2.0 + JWT) ─────────────────────────────────────────────────
# RS256 key pair — generate with: openssl genrsa 2048 | tee jwt_private.pem
# For local dev, leave blank and a temporary key pair is generated in memory.
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Runtime environment — controls dev-only features (dev-token endpoint).
# MUST be set to "production" in all cloud deployments.
# Defaults to "production" when unset (safe default).
ENVIRONMENT=development

# OAuth IdP credentials (register apps at each IdP's developer console)
# OAUTH_REDIRECT_BASE_URL: base URL of this API server (where IdP sends the callback)
# COCKPIT_BASE_URL: base URL of the cockpit SPA (where browser lands after auth)
OAUTH_REDIRECT_BASE_URL=http://localhost:8000
COCKPIT_BASE_URL=http://localhost:3000
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=

# ── Phase 5: Sub-Agent Parallel Orchestration ────────────────────────────────
# Maximum number of SubAgentRunner instances active simultaneously.
# Jobs beyond this cap queue in AGENT_JOBS broker queue.
GRAPHCLAW_MAX_CONCURRENT_AGENTS=4

# Dedicated SkillWorker pool size for sub-agents (separate from orchestrator pool).
GRAPHCLAW_SUBAGENT_WORKER_POOL_SIZE=4

# How often (seconds) each SubAgentRunner emits a heartbeat event.
GRAPHCLAW_AGENT_HEARTBEAT_INTERVAL_SECONDS=60

# Inactivity threshold (seconds) before AgentHealthMonitor marks task BLOCKED.
GRAPHCLAW_AGENT_HEARTBEAT_TIMEOUT_SECONDS=300
